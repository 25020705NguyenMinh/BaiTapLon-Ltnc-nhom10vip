<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vn.edu.auction.client.AuthController"
      alignment="CENTER"
      spacing="13"
      prefWidth="420"
      prefHeight="500"
      styleClass="auth-root">
    <padding>
        <Insets top="3" right="40" bottom="30" left="40"/>
    </padding>

    <VBox> <Label text="Quên mật khẩu?"
                  styleClass="app-title" /></VBox>
    <VBox spacing="7">

                <Label text="Nhập địa chỉ email của bạn, và chúng tôi sẽ gửi cho bạn một mã để giúp bạn truy cập tài khoản."
                wrapText="true"
                maxWidth="320"/>
    </VBox>

    <VBox spacing="7">
        <Label text="Email" styleClass="field-label"/>
        <TextField fx:id="emailField"
                   promptText="Nhập địa chỉ email"
                   styleClass="input-field"/>
    </VBox>
    <Label fx:id="messageLabel" maxWidth="320" styleClass="message-label" wrapText="true" />
    <HBox spacing="8" alignment="CENTER_RIGHT" maxWidth="Infinity">
        <Button text="Quay lại"
                onAction="#openLoginView"
                styleClass="secondary-button"/>

        <Button text="Xác nhận"
                onAction="#handleConfirmReset"
                styleClass="primary-button"/>
    </HBox>
</VBox>
