<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vn.edu.auction.client.AuthController"
      alignment="CENTER"
      spacing="13"
      prefWidth="420"
      prefHeight="620"
      styleClass="auth-root">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <Label text="TECH AUCTION" styleClass="app-title"/>
    <Label text="Tạo tài khoản mới" styleClass="subtitle"/>

    <VBox spacing="6">
        <Label text="Họ và tên" styleClass="field-label"/>
        <TextField fx:id="fullNameField"
                   promptText="Nhập họ và tên"
                   styleClass="input-field"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Email" styleClass="field-label"/>
        <TextField fx:id="emailField"
                   promptText="Nhập địa chỉ email"
                   styleClass="input-field"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Mật khẩu" styleClass="field-label"/>
        <PasswordField fx:id="passwordField"
                       promptText="Tạo mật khẩu"
                       styleClass="input-field"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Vai trò" styleClass="field-label"/>
        <ComboBox fx:id="roleComboBox"
                  maxWidth="Infinity"
                  promptText="Chọn vai trò"
                  styleClass="input-field"/>
    </VBox>

    <Label fx:id="messageLabel"
           wrapText="true"
           maxWidth="320"
           styleClass="message-label"/>

    <Button fx:id="registerButton"
            text="Đăng ký"
            onAction="#handleRegister"
            maxWidth="Infinity"
            styleClass="primary-button"/>

    <VBox alignment="CENTER" spacing="5">
        <Label text="Bạn đã có tài khoản?" styleClass="footer-text"/>
        <Hyperlink text="Đăng nhập"
                   onAction="#openLoginView"
                   styleClass="auth-link"/>
    </VBox>

</VBox>

