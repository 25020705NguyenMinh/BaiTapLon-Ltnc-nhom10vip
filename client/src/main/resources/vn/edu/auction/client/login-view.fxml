<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vn.edu.auction.client.AuthController"
      alignment="CENTER"
      spacing="16"
      prefWidth="420"
      prefHeight="500"
      styleClass="auth-root">

    <padding>
        <Insets top="35" right="40" bottom="35" left="40"/>
    </padding>

    <Label text="TECH AUCTION" styleClass="app-title"/>
    <Label text="Chào mừng bạn trở lại" styleClass="subtitle"/>

    <VBox spacing="7">
        <Label text="Email" styleClass="field-label"/>
        <TextField fx:id="emailField"
                   promptText="Nhập địa chỉ email"
                   styleClass="input-field"/>
    </VBox>

    <VBox spacing="7">
        <Label text="Mật khẩu" styleClass="field-label"/>
        <PasswordField fx:id="passwordField"
                       promptText="Nhập mật khẩu"
                       styleClass="input-field"/>
    </VBox>

    <Label fx:id="messageLabel"
           wrapText="true"
           maxWidth="320"
           styleClass="message-label"/>

    <Button fx:id="loginButton"
            text="Đăng nhập"
            onAction="#handleLogin"
            maxWidth="Infinity"
            styleClass="primary-button"/>

    <VBox alignment="CENTER" spacing="5">
        <Label text="Bạn chưa có tài khoản?" styleClass="footer-text"/>
        <Hyperlink text="Đăng ký ngay"
                   onAction="#openRegisterView"
                   styleClass="auth-link"/>
    </VBox>

</VBox>
